  "reasoningRules": [
    { "providers": ["kimi"], "pattern": "k2\\.7-code|thinking", "efforts": ["high"] },
    { "providers": ["kimi"], "pattern": "k2\\.6|k2\\.5", "efforts": ["none", "high"] },
    { "providers": ["deepseek"], "pattern": "v4-(?:flash|pro)|reasoner", "efforts": ["none", "high", "max"] },
    { "providers": ["glm"], "pattern": "glm-5\\.2", "efforts": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] },
    { "providers": ["glm"], "pattern": "glm-(?:5\\.1|5|4\\.[5-7])", "efforts": ["none", "high"] },
    { "pattern": "gpt-oss", "efforts": ["low", "medium", "high"] },
    { "providers": ["groq"], "pattern": "qwen3", "efforts": ["none", "high"] },
    { "providers": ["ollama-local", "ollama-cloud"], "pattern": "qwen3|deepseek|reason|thinking", "efforts": ["none", "high"] },
    { "providers": ["qwen"], "pattern": "qwen3", "efforts": ["none", "high"] }
  ],
  "visionPattern": "vision|vl|gpt-4o|gpt-5|gemini|pixtral|llava|qwen.*vl|kimi-k2\\.[5-7]",
  "nonToolPattern": "embed|moderation|rerank|whisper|tts|image|audio|guard",
  "nonChatPattern": "embed|moderation|rerank|whisper|transcri|tts|image|dall-e|realtime|audio|guard"
