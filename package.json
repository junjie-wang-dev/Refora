{
  "name": "refora",
  "version": "0.1.0",
  "description": "Local-first PDF literature manager",
  "main": "out/main/index.js",
  "author": "Refora",
  "license": "MIT",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build:server-sidecar": "sh scripts/build-server-sidecar.sh",
    "generate:server-contract": "node scripts/generate-server-contract.mjs",
    "check:server-contract": "node scripts/generate-server-contract.mjs --check",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "npm run check:server-contract && electron-vite build",
    "ci:local": "sh scripts/ci-local.sh",
    "verify": "npm run typecheck && npm run typecheck:tests && npm run lint && npm run test:coverage && npm run test:backend && npm run test:backend-source && npm run test:server-integration",
    "typecheck": "npm run check:server-contract && tsc -b",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:backend": "uv run --project backend --locked python -m pytest -c backend/pyproject.toml backend/tests",
    "test:backend-source": "uv run --project backend --locked python -m compileall -q backend/refora_server backend/workers",
    "test:server-integration": "vitest run --config vitest.server-integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "pretest:e2e": "electron-vite build",
    "test:e2e": "playwright test",
    "test:e2e:ci": "npm run test:e2e -- --workers=1",
    "test:e2e:workspace-card": "electron-vite build && playwright test tests/e2e/workspace-card-pointer.spec.ts --workers=1",
    "supabase:migrations": "node scripts/supabase-remote.mjs migration list",
    "supabase:push:dry-run": "node scripts/supabase-remote.mjs db push --dry-run",
    "supabase:push": "node scripts/supabase-remote.mjs db push",
    "supabase:test": "node scripts/supabase-remote.mjs test rpc",
    "supabase:test:local": "uv run --project backend --locked python scripts/test-supabase-local.py",
    "package": "sh scripts/package-macos.sh"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "electron-log": "^5.1.0",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@eslint/js": "^10.0.1",
    "@lobehub/fluent-emoji": "^4.1.0",
    "@lobehub/icons": "^5.10.1",
    "@lobehub/ui": "^5.19.0",
    "@playwright/test": "^1.61.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "antd": "^6.5.0",
    "clsx": "^2.1.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "i18next": "^26.3.6",
    "jsdom": "^29.1.1",
    "katex": "^0.16.47",
    "motion": "^12.42.2",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.5.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
